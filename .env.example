# Recoveria environment contract — names and safe placeholders only.
# Never paste a real credential, database URL, customer identifier, Drive root,
# OAuth token, KMS resource, or production/staging value into this file.

# LOCAL REQUIRED
# None for the default synthetic UI, lint, typecheck, unit tests, or build.

# LOCAL OPTIONAL — disposable local persistence/integration only
DATABASE_URL=postgresql://recoveria:recoveria@127.0.0.1:5432/recoveria_dev?schema=public
RECOVERIA_TEST_DATABASE_URL=
RECOVERIA_TEST_DATABASE_ALLOWLIST=
RECOVERIA_PRODUCT_SURFACE_DOCUMENT_DIRECTORY=
RECOVERIA_REVIEW_SERVER_PORT=4873
PORT=3000

# BROWSER-SAFE / PUBLIC CONFIGURATION
# OAuth client IDs are public identifiers, not client secrets.
NEXT_PUBLIC_RECOVERIA_GOOGLE_CLIENT_ID=

# SYNTHETIC STAGING — SERVER ONLY
# Actual values live in platform secret/configuration stores, never in Git.
RECOVERIA_ENVIRONMENT=
RECOVERIA_DATABASE_URL=
RECOVERIA_GOOGLE_PROJECT_ID=
RECOVERIA_ORGANIZATION_ID=
RECOVERIA_CONNECTION_ID=
RECOVERIA_REQUIRED_SCOPE=
