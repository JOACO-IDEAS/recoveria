# Local composition bridge between the root API and the separate web surface.
RECOVERIA_CORE_PRODUCT_SURFACE_URL=
RECOVERIA_CORE_PRODUCT_SURFACE_TOKEN=

# CLIENT ZERO READ-ONLY — SERVER ONLY / HUMAN-GATED
# Never set for normal development. The collections/outbound capability flags
# must be ABSENT here; even present-but-false is rejected by code.
RECOVERIA_CLIENT_ZERO_INGESTION_ENABLED=
RECOVERIA_DATA_MODE=
RECOVERIA_CLIENT_ZERO_ACK=
RECOVERIA_CLIENT_ZERO_PATH=

# SPECIALIZED OPERATOR SCRIPTS — SERVER ONLY / NOT NORMAL SETUP
