FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY tsconfig.json ./
COPY src ./src
COPY scripts/staging/run-sync-worker.ts ./scripts/staging/run-sync-worker.ts
ENV NODE_ENV=production
CMD ["./node_modules/.bin/tsx", "scripts/staging/run-sync-worker.ts"]
